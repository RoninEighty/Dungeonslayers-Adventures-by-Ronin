    {
      "sort": 400000,
      "name": "Ausrüstungsraum",
      "type": "text",
      "_id": "sSpEBN5y3kwK232z",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p>In maroden Schränken liegen die Wappenröcke der Stadtwache. Mit ihnen lässt sich leichter an den Wachen im oberen Stockwerk vorbei kommen.</p>"
      },
      "video": {
        "controls": true,
