    {
      "sort": 200000,
      "name": "Wachraum",
      "type": "text",
      "_id": "M5wYAebHcauTo1ue",
      "system": {},
      "title": {
        "show": true,
        "level": 1
      },
      "image": {},
      "text": {
        "format": 1,
        "content": "<p>Hier sitzen zwei Wachen und spielen mit Würfeln. Entweder kommen die SC unbemerkt an ihnen vorbei (Probe Schleichen), oder sie werden anders abgelenkt.</p>"
      },
      "video": {
        "controls": true,
        "volume": 0.5
